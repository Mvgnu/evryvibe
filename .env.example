# Copy to .env.local for Next.js and the MCP/migration commands.
DATABASE_URL=postgres://evryvibe:evryvibe@localhost:5438/evryvibe
# Explicitly fictional preview. Use only for development; never a live-data fallback.
EVRYVIBE_DEMO=0
# Disposable database only; integration tests may remove test rows.
TEST_DATABASE_URL=postgres://evryvibe:evryvibe@localhost:5438/evryvibe_test
# Use a second disposable database so transport and repository tests do not collide.
MCP_TEST_DATABASE_URL=postgres://evryvibe:evryvibe@localhost:5438/evryvibe_mcp_test
# Separate disposable database for OCR → MCP integration tests.
COLLECTOR_TEST_DATABASE_URL=postgres://evryvibe:evryvibe@localhost:5438/evryvibe_collector_test
# Protects /ops/sources (Basic auth username: operator). Unset denies access.
EVRYVIBE_OPERATOR_PASSWORD=
# Dedicated local browser profile; cookies and prepared packages stay gitignored.
EVRYVIBE_INSTAGRAM_STATE_DIR=.local/instagram
# Reusable OCR stills/frames; production .local points to persistent shared state.
EVRYVIBE_MEDIA_DIR=.local/media
TESSERACT_BIN=tesseract
OCR_LANG=eng
# Optional server-side visit analytics. Keep the secret on the origin; never use NEXT_PUBLIC_.
MINILYTICS_COLLECTOR_URL=https://analytics.magnusohle.de/api/collect
MINILYTICS_SITE_ID=evryvibe
MINILYTICS_SITE_SECRET=
