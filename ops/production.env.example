NODE_ENV=production
DATABASE_URL=postgres://evryvibe:REPLACE_WITH_URL_ENCODED_SECRET@127.0.0.1:5432/evryvibe
EVRYVIBE_DEMO=0
EVRYVIBE_OPERATOR_PASSWORD=REPLACE_WITH_RANDOM_SECRET
EVRYVIBE_INSTAGRAM_STATE_DIR=/srv/evryvibe/shared/.local/instagram
PLAYWRIGHT_BROWSERS_PATH=/srv/evryvibe/shared/ms-playwright
TESSERACT_BIN=/usr/bin/tesseract
OCR_LANG=eng+deu
EVRYVIBE_MCP_ORIGIN=https://evryvibe.com
EVRYVIBE_MCP_PORT=3301
EVRYVIBE_MCP_STATE_FILE=/srv/evryvibe/shared/.local/mcp/oauth-state.json

# Artist claims stay disabled until Meta app, messaging permission and webhook
# subscription are configured and live-tested. Never commit real credentials.
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=
# META_INSTAGRAM_ACCESS_TOKEN=
# META_INSTAGRAM_ACCOUNT_ID=
# META_GRAPH_API_VERSION=
# CLAIM_TOKEN_SECRET= at least 32 random characters
# Optional override; defaults to public Nominatim under its usage policy.
# EVRYVIBE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
