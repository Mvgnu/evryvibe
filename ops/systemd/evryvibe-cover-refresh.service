[Unit]
Description=Refresh EVRYVIBE public Instagram post and reel cover URLs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=evryvibe
Group=evryvibe
WorkingDirectory=/srv/evryvibe/current
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/srv/evryvibe/current/ops/bin/refresh-covers.sh
TimeoutStartSec=infinity
TimeoutStopSec=30
KillMode=control-group
MemoryHigh=1G
MemoryMax=1536M
MemorySwapMax=256M
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/evryvibe/shared
