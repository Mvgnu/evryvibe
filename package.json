{
  "name": "evryvibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "genres:normalize": "tsx --env-file-if-exists=.env.local scripts/normalize-genres.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "mcp": "tsx --env-file-if-exists=.env.local src/mcp/server.ts",
    "mcp:http": "tsx --env-file-if-exists=.env.local src/mcp/http-server.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:published": "tsx scripts/verify-published.ts",
    "collect": "tsx --env-file-if-exists=.env.local scripts/collect.ts",
    "covers:refresh": "tsx --env-file-if-exists=.env.local scripts/refresh-instagram-covers.ts",
    "instagram:login": "tsx --env-file-if-exists=.env.local scripts/instagram-login.ts",
    "test:ops": "playwright test --config=playwright.ops.config.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "drizzle-orm": "0.45.3",
    "next": "16.4.2",
    "playwright": "^1.63.0",
    "postgres": "^3.4.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
